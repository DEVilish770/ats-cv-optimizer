generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CV {
  id              String      @id @default(cuid())
  sessionId       String      // Anonymous browser session ID
  originalFileUrl String
  originalType    String
  rawText         String      @db.Text
  structured      Json
  targetRole      String?
  targetSkills    String[]
  versions        CVVersion[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CVVersion {
  id            String       @id @default(cuid())
  cvId          String
  cv            CV           @relation(fields: [cvId], references: [id], onDelete: Cascade)
  jobId         String
  job           Job          @relation(fields: [jobId], references: [id])
  optimizedData Json
  diffData      Json
  atsScore      Int
  pdfUrl        String?
  application   Application?
  createdAt     DateTime     @default(now())
}

model Job {
  id           String        @id @default(cuid())
  externalId   String
  source       String
  title        String
  company      String
  location     String?
  jobType      String?
  description  String        @db.Text
  url          String
  salaryMin    Int?
  salaryMax    Int?
  requirements Json?
  postedAt     DateTime?
  scrapedAt    DateTime      @default(now())
  cvVersions   CVVersion[]
  applications Application[]

  @@unique([externalId, source])
}

model Application {
  id          String     @id @default(cuid())
  sessionId   String     // Anonymous browser session ID
  jobId       String
  job         Job        @relation(fields: [jobId], references: [id])
  cvVersionId String?    @unique
  cvVersion   CVVersion? @relation(fields: [cvVersionId], references: [id])
  status      String     @default("optimized")
  appliedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([sessionId, jobId])
}
